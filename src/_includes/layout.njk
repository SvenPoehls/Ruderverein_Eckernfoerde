{% from "icons.njk" import facebook_icon, instagram_icon, star_icon %}
{% set seiten_beschreibung = beschreibung or (betrieb.name + ' - ' + betrieb.adresse.ort) %}
{% set seiten_url = betrieb.url + page.url %}
{# Vorschaubild für Google/Facebook/WhatsApp #}
{% set vorschau_bild = betrieb.url + "/assets/img/Boot.jpg" %}
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} · {{ betrieb.name }}</title>
  <meta name="description" content="{{ seiten_beschreibung }}">
  <link rel="canonical" href="{{ seiten_url }}">
  <link rel="stylesheet" href="/assets/css/style.css">
  <link rel="icon" type="image/svg+xml" href="/assets/img/favicon.svg">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ betrieb.name }}">
  <meta property="og:title" content="{{ title }} · {{ betrieb.name }}">
  <meta property="og:description" content="{{ seiten_beschreibung }}">
  <meta property="og:url" content="{{ seiten_url }}">
  <meta property="og:image" content="{{ vorschau_bild }}">
  <meta property="og:locale" content="de_DE">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title }} · {{ betrieb.name }}">
  <meta name="twitter:description" content="{{ seiten_beschreibung }}">
  <meta name="twitter:image" content="{{ vorschau_bild }}">

  {% set json_ld = {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": betrieb.name,
    "image": vorschau_bild,
    "url": betrieb.url,
    "telephone": betrieb.kontakt.telefonLink,
    "email": betrieb.kontakt.email,
    "address": {
      "@type": "PostalAddress",
      "streetAddress": betrieb.adresse.strasse,
      "postalCode": betrieb.adresse.plz,
      "addressLocality": betrieb.adresse.ort,
      "addressCountry": "DE"
    },
    "sameAs": [betrieb.facebook, betrieb.instagram.link]
  } %}
  <script type="application/ld+json">{{ json_ld | dump | safe }}</script>
</head>
<body>
  <a class="skip-link" href="#hauptinhalt">Zum Hauptinhalt springen</a>

  <header class="site-header">
    <div class="container site-header__inner">
      <a class="site-header__brand" href="/">
        <span class="site-header__brand-text">{{ betrieb.name }}</span>
      </a>

      <button class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="hauptnavigation">
        <span class="sr-only">Menü öffnen</span>
        <span class="nav-toggle__bar" aria-hidden="true"></span>
      </button>

      <nav class="site-nav" id="hauptnavigation" aria-label="Hauptnavigation">
        <ul>
          <li><a href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>Startseite</a></li>
          <li><a href="/ueber-uns/"{% if page.url == "/ueber-uns/" %} aria-current="page"{% endif %}>Über uns</a></li>
          <li><a href="/fischbestand/"{% if page.url == "/fischbestand/" %} aria-current="page"{% endif %}>Fischbestand</a></li>
          <li><a href="/regeln/"{% if page.url == "/regeln/" %} aria-current="page"{% endif %}>Regeln &amp; Angelordnung</a></li>
          <li><a href="/anfahrt-kontakt/"{% if page.url == "/anfahrt-kontakt/" %} aria-current="page"{% endif %}>Anfahrt &amp; Kontakt</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="hauptinhalt">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="container site-footer__inner">
      <div class="site-footer__block">
        <h2>{{ betrieb.name }}</h2>
        <p>Inhaber: {{ betrieb.inhaber }}</p>
        <p>{{ betrieb.adresse.strasse }}<br>{{ betrieb.adresse.plz }} {{ betrieb.adresse.ort }}</p>
      </div>
      <div class="site-footer__block">
        <h2>Kontakt</h2>
        <p><a href="tel:{{ betrieb.kontakt.telefonLink }}">{{ betrieb.kontakt.telefon }}</a></p>
        <p><a href="mailto:{{ betrieb.kontakt.email }}">{{ betrieb.kontakt.email }}</a></p>
        <p><a class="social-link" href="{{ betrieb.facebook }}" target="_blank" rel="noopener">{{ facebook_icon() }} Facebook-Seite</a></p>
        <p><a class="social-link" href="{{ betrieb.instagram.link }}" target="_blank" rel="noopener">{{ instagram_icon() }} Instagram ({{ betrieb.instagram.name }})</a></p>
        <p><a class="social-link" href="{{ betrieb.googleBewertungenLink }}" target="_blank" rel="noopener">{{ star_icon() }} Google-Bewertungen</a></p>
      </div>
      <div class="site-footer__block">
        <h2>Öffnungszeiten</h2>
        {% for zeit in betrieb.oeffnungszeiten %}
        <p><strong>{{ zeit.zeitraum }}:</strong><br>{{ zeit.zeiten }}</p>
        {% endfor %}
      </div>
    </div>
    <div class="container site-footer__copyright">
      <p>&copy; {{ betrieb.jahr }} {{ betrieb.name }} · <a href="/impressum/">Impressum</a> · <a href="/datenschutz/">Datenschutz</a></p>
    </div>
  </footer>

  <script src="/assets/js/nav.js"></script>
  {% if zusatzScript %}<script src="{{ zusatzScript }}"></script>{% endif %}
</body>
</html>
